      "><span class="line"><span class="cl"><span class="c1"># 配置域名地址</span>
</span></span><span class="line"><span class="cl"><span class="n">external_url</span> <span class="s1">&#39;https://git.kentxxq.com&#39;</span>
</span></span><span class="line"><span class="cl"><span class="c1"># ssh地址</span>
</span></span><span class="line"><span class="cl"><span class="n">gitlab_rails</span><span class="o">[</span><span class="s1">&#39;gitlab_ssh_host&#39;</span><span class="o">]</span> <span class="o">=</span> <span class="s1">&#39;git.kentxxq.com&#39;</span>
</span></span><span class="line"><span class="cl"><span class="c1"># ssh端口</span>
</span></span><span class="line"><span class="cl"><span class="n">gitlab_rails</span><span class="o">[</span><span class="s1">&#39;gitlab_shell_ssh_port&#39;</span><span class="o">]</span> <span class="o">=</span> <span class="mi">10022</span>
</span></span><span class="line"><span class="cl"><span class="c1"># nginx的地址,允许它代理gitlab</span>
</span></span><span class="line"><span class="cl"><span class="n">gitlab_rails</span><span class="o">[</span><span class="s1">&#39;trusted_proxies&#39;</span><span class="o">]</span> <span class="o">=</span> <span class="o">[</span><span class="s1">&#39;nginx的ip地址&#39;</span><span class="o">]</span>
</span></span><span class="line"><span class="cl"><span class="c1"># 禁用自带的 nginx</span>
</span></span><span class="line"><span class="cl"><span class="n">nginx</span><span class="o">[</span><span class="s1">&#39;enable&#39;</span><span class="o">]</span> <span class="o">=</span> <span class="kp">false</span>
</span></span><span class="line"><span class="cl"><span class="c1"># 服务监听方式</span>
</span></span><span class="line"><span class="cl"><span class="n">gitlab_workhorse</span><span class="o">[</span><span class="s1">&#39;listen_network&#39;</span><span class="o">]</span> <span class="o">=</span> <span class="s2">&#34;tcp&#34;</span>
</span></span><span class="line"><span class="cl"><span class="n">gitlab_workhorse</span><span class="o">[</span><span class="s1">&#39;listen_addr&#39;</span><span class="o">]</span> <span class="o">=</span> <span class="s2">&#34;0.0.0.0:80&#34;</span></span></span></code></pre>
